<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/top_splash_item"
        android:layout_width="@dimen/item_one_width"
        android:layout_height="@dimen/item_one_height"
        android:background="@drawable/splash_item_one"
        android:translationX="@dimen/item_one_translationX"
        android:translationY="@dimen/item_one_translationY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/splash_image"
        android:layout_width="@dimen/splash_logo_width"
        android:layout_height="@dimen/splash_logo_height"
        app:srcCompat="@drawable/app_logo"
        app:shapeAppearance="@style/drawer_image_style"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splash_text"
        android:layout_marginTop="@dimen/splash_logo_margin_top"/>

    <TextView
        android:id="@+id/splash_text"
        android:text="@string/splash_text_one"
        android:textSize="@dimen/splash_text_size"
        android:fontFamily="@font/open_sans_semi_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_image"
        app:layout_constraintBottom_toTopOf="@id/splash_progressbar"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splash_progressbar"
        android:layout_width="@dimen/progress_width"
        android:layout_height="@dimen/progress_height"
        android:max="100"
        android:min="0"
        app:indicatorColor="@color/orange"
        app:trackColor="@color/mid_grey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_text"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/bottom_splash_item"
        android:layout_width="@dimen/item_two_width"
        android:layout_height="@dimen/item_two_height"
        android:background="@drawable/splash_item_one"
        android:translationX="@dimen/item_two_translationX"
        android:translationY="@dimen/item_two_translationY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>