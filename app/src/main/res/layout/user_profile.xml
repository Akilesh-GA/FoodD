<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_profile_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/profile_text"
        android:text="@string/profile_text"
        android:textSize="@dimen/text_size_20"
        android:fontFamily="@font/open_sans_semi_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/margin_start_50"
        android:layout_marginTop="@dimen/margin_top_50"
        app:layout_constraintBottom_toTopOf="@id/profile_image"
        app:layout_constraintEnd_toStartOf="@id/profile_image"/>

<!--    <TextView-->
<!--        android:id="@+id/edit_icon"-->
<!--        android:layout_width="@dimen/width_50"-->
<!--        android:layout_height="@dimen/height_50"-->
<!--        app:srcCompat="@drawable/edit_icon" />-->

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profile_image"
        android:layout_width="@dimen/profile_image_width"
        android:layout_height="@dimen/profile_image_height"
        app:srcCompat="@drawable/user"
        app:layout_constraintTop_toTopOf="@id/profile_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/user_data_layout"
        android:layout_marginTop="@dimen/margin_top_100"
        app:shapeAppearanceOverlay="@style/user_profile_style"/>

    <LinearLayout
        android:id="@+id/user_data_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_image"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/margin_top_100">

        <TextView
            android:id="@+id/user_name"
            android:text="@string/user_name"
            android:textSize="@dimen/text_size_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_15"/>

        <TextView
            android:id="@+id/user_email"
            android:text="@string/user_email"
            android:textSize="@dimen/text_size_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_15"/>

        <TextView
            android:id="@+id/user_mobile"
            android:text="@string/user_mobile"
            android:textSize="@dimen/text_size_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_15"/>

        <TextView
            android:id="@+id/user_gender"
            android:text="@string/user_gender"
            android:textSize="@dimen/text_size_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_15"/>

    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_data_layout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread">

    <Button
        android:id="@+id/disable_account"
        android:text="@string/disable_account_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/delete_account"
        tools:ignore="MissingConstraints"
        android:layout_marginEnd="@dimen/margin_end_40"/>

    <Button
        android:id="@+id/delete_account"
        android:text="@string/delete_account_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/disable_account"
        tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>