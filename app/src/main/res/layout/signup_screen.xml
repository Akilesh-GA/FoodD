<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/signup_screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/foodd_logo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:srcCompat="@drawable/app_logo"
        app:shapeAppearanceOverlay="@style/drawer_image_style"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/signup_text"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/signup_text"
        android:text="Create Account"
        android:textSize="30sp"
        android:textColor="@color/orange"
        android:fontFamily="@font/open_sans_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/foodd_logo"
        app:layout_constraintBottom_toTopOf="@id/signup_sub_text"
        android:layout_margin="20dp"/>

    <TextView
        android:id="@+id/signup_sub_text"
        android:text="Let's get you started with FoodD."
        android:textSize="15sp"
        android:textColor="@color/light_grey"
        android:fontFamily="@font/open_sans_regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/signup_text"
        app:layout_constraintTop_toBottomOf="@id/signup_text" />

    <EditText
        android:id="@+id/signup_name_field"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:hint="Enter Name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup_sub_text"
        app:layout_constraintBottom_toTopOf="@id/signup_email_field"
        android:contentDescription="username"
        android:inputType="textPersonName"
        android:background="@drawable/edittext_shape"
        android:paddingStart="25dp"/>

    <EditText
        android:id="@+id/signup_email_field"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:hint="Enter Email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup_name_field"
        app:layout_constraintBottom_toTopOf="@id/signup_password_field"
        android:contentDescription="email"
        android:inputType="textEmailAddress"
        android:background="@drawable/edittext_shape"
        android:paddingStart="25dp"/>

    <EditText
        android:id="@+id/signup_password_field"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:hint="Enter Password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup_email_field"
        app:layout_constraintBottom_toTopOf="@id/signup_c_password_field"
        android:contentDescription="password"
        android:inputType="textPassword"
        android:background="@drawable/edittext_shape"
        android:paddingStart="25dp"/>

    <EditText
        android:id="@+id/signup_c_password_field"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:hint="Enter Password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup_password_field"
        app:layout_constraintBottom_toTopOf="@id/signup_button"
        android:contentDescription="password"
        android:inputType="textPassword"
        android:background="@drawable/edittext_shape"
        android:paddingStart="25dp"/>

    <Button
        android:id="@+id/signup_button"
        android:text="Sign Up"
        android:layout_width="210dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="@+id/signup_c_password_field"
        app:layout_constraintEnd_toEndOf="@+id/signup_c_password_field"
        app:layout_constraintTop_toBottomOf="@+id/signup_c_password_field"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>