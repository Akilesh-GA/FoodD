<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include layout="@layout/home_layout"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navigation_drawer"
        android:layout_width="@dimen/drawer_layout_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_bg"
        android:padding="@dimen/layout_padding_20">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/drawer_logo"
            app:srcCompat="@drawable/app_logo"
            android:layout_marginTop="@dimen/margin_50"
            android:layout_width="@dimen/drawer_icon_width"
            android:layout_height="@dimen/drawer_icon_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/drawer_head"
            app:shapeAppearanceOverlay="@style/drawer_image_style"/>

        <TextView
            android:id="@+id/drawer_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drawer_head"
            android:textSize="@dimen/text_size_20"
            android:layout_marginTop="@dimen/margin_top_15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/drawer_logo"
            app:layout_constraintBottom_toTopOf="@+id/drawer_body"/>

        <TextView
            android:id="@+id/drawer_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drawer_body"
            android:textSize="@dimen/text_size_15"
            android:layout_marginTop="@dimen/margin_top_15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/drawer_head" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_30"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/close" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>